
        function calculateFactorial(n){
            let result = 1;
            for(i = 1; i <= n; i++){
            result = result * i ;
        }
        return result;
    }

    let numbers = [2,4,5,7,8,9];
    for(let i = 0; i < numbers.length; i ++){
        let result = calculateFactorial(numbers[i]);
        console.log("Factorial of " , numbers[i] , " is ", result);
    }
    
   
